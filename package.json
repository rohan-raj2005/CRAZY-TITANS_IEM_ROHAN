{
  "name": "studypulse",
  "version": "1.0.0",
  "description": "STUDY PULSE - AI-Based Academic Procrastination Pattern Detection System",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "train": "npm --prefix backend run train",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:frontend",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend run dev",
    "start": "node backend/src/server.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "academic-procrastination",
    "machine-learning",
    "xgboost",
    "random-forest",
    "logistic-regression",
    "explainable-ai",
    "react",
    "vite",
    "express"
  ],
  "author": "Google DeepMind Advanced Pair Programming",
  "license": "MIT"
}
